{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BranchMark",
  "version": "1.0.0",
  "identifier": "com.deepconvo.mindmap.tauri",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BranchMark",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
